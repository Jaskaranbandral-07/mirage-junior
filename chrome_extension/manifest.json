{
  "manifest_version": 3,
  "name": "MIRAGE Shield — Deception Honeypot Extension",
  "version": "1.0.0",
  "description": "Clone any live website into a MIRAGE deception honeypot in 1 click, trap attackers, capture credentials & IPs, and block threats.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "MIRAGE Shield — Protect This Website",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
